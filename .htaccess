RewriteEngine On

# Blokir akses langsung ke file-file sensitif lewat address bar
<FilesMatch "\.(sql|log|env|md|lock)$">
    Require all denied
</FilesMatch>

<Files "composer.json">
    Require all denied
</Files>
<Files "composer.lock">
    Require all denied
</Files>

# Matikan directory listing
Options -Indexes

# Hilangkan ekstensi .php di URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [NC,L]